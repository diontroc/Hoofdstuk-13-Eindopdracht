class Bal {
  int x;
  int y;
  int diameter = 30;
    
  Bal(int ballX, int ballY, int diameter) {
    x = ballX;
    y = ballY;
    this.diameter = diameter;
  }

  void tekenBall() {
      ellipse(x, y  , diameter, diameter);
  }
      
  void resetBall() {
     y = -diameter;
     x = (int)random(diameter/2, width - diameter/2);
}
  }

Bal[] ballen = new Bal[3];
int score = 0;
int snelheid;
int ballYSpeed = 5;
int rectY = 450;
int rectW = 100;
int rectH = 20;
int puntX = 100;
int rectX = mouseX;
int i;


void setup() {
  size(500, 500);
  snelheid = 50;
  rectMode(CENTER);
  for (int i = 0; i < ballen.length; i++){
    ballen[i] = new Bal(100 + i * 150, -100, 30);
  }
}

void draw() {
  background(32);
  
  textSize(35);
  text("SCORE = " + score, 40, 120);
  
    rect(mouseX, rectY, rectW, rectH);
    
    for (int j = 0; j < ballen.length; j++){
      ballen[j].tekenBall();
  
  ballen[j].y += ballYSpeed;
  
  if (ballen[j].y + ballen[j].diameter/2 >= rectY - rectH/2 && ballen[j].y - ballen[j].diameter/2 < rectY - rectH/2 && ballen[j].x + ballen[j].diameter/2 >= mouseX - rectW/2 && ballen[j].x - ballen[j].diameter/2 <= mouseX + rectW/2 && ballYSpeed > 0) {
    ballen[j].resetBall();
    score++;
  }
  
  if (ballen[j].y> height) {
    ballen[j].resetBall();
   }
  }
}
